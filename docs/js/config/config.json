{
  "assets": {
    "defaultRemoteAssetsRoot": "https://huggingface.co/datasets/RogersPyke/robocoin_datamanager_assets/resolve/main"
  },
  "downloadCommand": {
    "command": "robocoin-download",
    "hubParam": "--hub",
    "datasetsParam": "--ds_lists",
    "targetDirParam": "--target-dir",
    "lineContinuation": " \\",
    "lineBreak": "\n",
    "datasetSeparator": " \\\n",
    "defaultPathComment": "# the default download path is ~/.cache/huggingface/lerobot/, if you want to speicifiy download dir, please add",
    "targetDirComment": "# --target-dir YOUR_DOWNLOAD_DIR"
  },
  "app": {
    "version": "v1.1",
    "title": "RoboCOIN-DataManager"
  },
  "defaults": {
    "enableExclude": false,
    "layout": {
      "contentPadding": 12
    },
    "grid": {
      "minCardWidth": 180,
      "cardHeight": 300,
      "gap": 16,
      "columns": 4,
      "bufferRows": 2,
      "padding": 12
    },
    "selection": {
      "itemHeight": 45,
      "padding": 16,
      "bufferItems": 20
    },
    "observer": {
      "margin": 200,
      "threshold": 0.1
    },
    "badge": {
      "size": 24,
      "margin": 8
    },
    "timing": {
      "hoverDelay": 800,
      "resizeDebounce": 200,
      "scrollThrottle": 16,
      "transitionDuration": 200,
      "fadeDuration": 300
    },
    "preview": {
      "maxWidth": 320,
      "minWidth": 240,
      "padding": 16,
      "offset": 8
    },
    "ui": {
      "buttonSize": 32,
      "iconSize": 16,
      "borderRadius": 4
    },
    "loading": {
      "batchSize": 150
    }
  }
}

